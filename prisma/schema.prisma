// Prisma schema — PostgreSQL (Supabase). See docs/database.md.

generator client {
  provider        = "prisma-client-js"
  // Loads relations (e.g. a shipment with its events) in one SQL query instead of one per relation.
  // Each query is a round trip to the database, so this matters most when it is far away.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // transaction pooler (runtime)
  directUrl = env("DIRECT_URL") // session pooler (migrations)
}

// ─── Tracking domain ────────────────────────────────────────────────────────

enum ShipmentStatus {
  INFO_RECEIVED
  ACCEPTED
  IN_TRANSIT
  ARRIVED_AT_FACILITY
  OUT_FOR_DELIVERY
  ON_HOLD
  DELIVERED
  EXCEPTION
  RETURNED_TO_SENDER
}

/// Where a tracking event came from. DEMO events are sample data only.
enum EventSource {
  MANUAL
  CARRIER_API
  DEMO
}

/// MANUAL: staff record every scan. CARRIER: events are synced from a carrier API and cannot be hand-edited.
enum TrackingMode {
  MANUAL
  CARRIER
}

enum ShipmentOrigin {
  ADMIN
  PUBLIC_LOOKUP
}

model Shipment {
  id             String         @id @default(cuid())
  trackingNumber String         @unique @map("tracking_number") @db.VarChar(40)
  status         ShipmentStatus @default(INFO_RECEIVED)
  serviceLevel   String?        @map("service_level") @db.VarChar(80)
  /// Public description of the package and its contents. See PACKAGE_DESCRIPTIONS.
  packageDescription String?    @map("package_description") @db.VarChar(80)

  // Public-safe location summary (city/region/country only).
  originCity         String? @map("origin_city") @db.VarChar(120)
  originRegion       String? @map("origin_region") @db.VarChar(120)
  originCountry      String? @map("origin_country") @db.Char(2)
  destinationCity    String? @map("destination_city") @db.VarChar(120)
  destinationRegion  String? @map("destination_region") @db.VarChar(120)
  destinationCountry String? @map("destination_country") @db.Char(2)

  // Private — never returned by the public tracking API.
  recipientName       String? @map("recipient_name") @db.VarChar(160)
  destinationPostcode String? @map("destination_postcode") @db.VarChar(20)
  internalNotes       String? @map("internal_notes") @db.Text

  /// Only set when a verified source supplies it; `estimateSource` must say which.
  estimatedDeliveryDate DateTime? @map("estimated_delivery_date") @db.Date
  estimateSource        String?   @map("estimate_source") @db.VarChar(120)
  deliveredAt           DateTime? @map("delivered_at") @db.Timestamptz(6)

  carrier           String? @db.VarChar(80)
  externalReference String? @map("external_reference") @db.VarChar(120)

  // ── Carrier sync (trackingMode = CARRIER) ──
  trackingMode          TrackingMode   @default(MANUAL) @map("tracking_mode")
  createdVia            ShipmentOrigin @default(ADMIN) @map("created_via")
  /// Which API is queried: "usps" | "dhl" | "ship24". See src/server/carriers/registry.ts.
  carrierProvider       String?        @map("carrier_provider") @db.VarChar(20)
  /// The number as the carrier knows it. Defaults to `trackingNumber`.
  carrierTrackingNumber String?        @map("carrier_tracking_number") @db.VarChar(40)
  /// The carrier's own wording of the current status, shown as-is.
  carrierStatusText     String?        @map("carrier_status_text") @db.VarChar(280)
  lastSyncedAt          DateTime?      @map("last_synced_at") @db.Timestamptz(6)
  /// When the scheduler should next poll the carrier. NULL = never (terminal or manual).
  nextSyncAt            DateTime?      @map("next_sync_at") @db.Timestamptz(6)
  /// Lease that stops two workers polling the same shipment at once.
  syncLeaseUntil        DateTime?      @map("sync_lease_until") @db.Timestamptz(6)
  syncFailureCount      Int            @default(0) @map("sync_failure_count")
  lastSyncError         String?        @map("last_sync_error") @db.VarChar(280)

  /// Sample record for development/demo. Shown with a conspicuous banner and hidden unless demo mode is on.
  isDemo Boolean @default(false) @map("is_demo")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events   TrackingEvent[]
  syncLogs CarrierSyncLog[]

  @@index([status])
  @@index([createdAt])
  @@index([trackingMode, nextSyncAt])
  @@index([carrierTrackingNumber])
  @@map("shipments")
}

model TrackingEvent {
  id                String         @id @default(cuid())
  shipmentId        String         @map("shipment_id")
  status            ShipmentStatus
  description       String         @db.VarChar(280)
  city              String?        @db.VarChar(120)
  region            String?        @db.VarChar(120)
  country           String?        @db.Char(2)
  /// IANA zone of the event location, used to display local time (e.g. "America/Chicago").
  timeZone          String?        @map("time_zone") @db.VarChar(64)
  occurredAt        DateTime       @map("occurred_at") @db.Timestamptz(6)
  source            EventSource    @default(MANUAL)
  /// Stable carrier event id (or a content hash). Lets repeated syncs upsert instead of duplicating.
  externalId        String?        @map("external_id") @db.VarChar(128)
  carrierStatusCode String?        @map("carrier_status_code") @db.VarChar(64)
  createdById       String?        @map("created_by_id")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([shipmentId, externalId])
  @@index([shipmentId, occurredAt(sort: Desc)])
  @@map("tracking_events")
}

/// One row per carrier API call. Kept 30 days; used for the admin sync panel and debugging.
model CarrierSyncLog {
  id            String   @id @default(cuid())
  shipmentId    String   @map("shipment_id")
  provider      String   @db.VarChar(20)
  /// "read" | "cron" | "manual" | "create"
  trigger       String   @db.VarChar(16)
  /// "ok" | "not_found" | "rate_limited" | "auth" | "unavailable" | "bad_response" | "not_configured"
  outcome       String   @db.VarChar(24)
  httpStatus    Int?     @map("http_status")
  durationMs    Int      @map("duration_ms")
  eventsAdded   Int      @default(0) @map("events_added")
  eventsRemoved Int      @default(0) @map("events_removed")
  error         String?  @db.VarChar(280)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("carrier_sync_logs")
}

// ─── Service catalogue (CMS for /services/[slug]) ───────────────────────────

enum ServiceKind {
  CATEGORY
  SERVICE
}

/// One page of the public /services/[slug] site section. Mirrors `ServiceDef` in src/config/services.ts.
model Service {
  id        String      @id @default(cuid())
  slug      String      @unique @db.VarChar(80)
  title     String      @db.VarChar(160)
  summary   String      @db.VarChar(400)
  icon      String?     @db.VarChar(200)
  kind      ServiceKind @default(SERVICE)
  /// Ordered slugs listed on a category page.
  children  String[]
  /// [{ heading, body }]
  sections  Json        @default("[]")
  ctaLabel  String?     @map("cta_label") @db.VarChar(80)
  ctaHref   String?     @map("cta_href") @db.VarChar(300)
  related   String[]
  published Boolean     @default(true)
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([published, sortOrder])
  @@map("services")
}

// ─── Support ────────────────────────────────────────────────────────────────

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model ContactInquiry {
  id             String        @id @default(cuid())
  name           String        @db.VarChar(120)
  email          String        @db.VarChar(254)
  trackingNumber String?       @map("tracking_number") @db.VarChar(40)
  topic          String        @db.VarChar(40)
  message        String        @db.Text
  status         InquiryStatus @default(NEW)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@map("contact_inquiries")
}

enum ServiceRequestType {
  QUOTE
  PICKUP
  SHIPPING
  ADDRESS_CHANGE
  CLAIM
  STAMPS
  PO_BOX
  HOLD_MAIL
  SUPPLIES
  REDELIVERY
  CUSTOMS
}

/// Customer requests submitted from the /tools pages, handled by staff in /admin/requests.
model ServiceRequest {
  id             String             @id @default(cuid())
  /// Customer-facing reference, e.g. "PU-7K3M9Q2X".
  reference      String             @unique @db.VarChar(16)
  type           ServiceRequestType
  status         InquiryStatus      @default(NEW)
  name           String             @db.VarChar(120)
  email          String             @db.VarChar(254)
  phone          String?            @db.VarChar(40)
  trackingNumber String?            @map("tracking_number") @db.VarChar(40)
  /// Type-specific fields, validated by src/validation/service-request.ts before storage.
  details        Json
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@index([type])
  @@map("service_requests")
}

enum ChatStatus {
  OPEN
  CLOSED
}

enum ChatSender {
  VISITOR
  AGENT
}

model ChatConversation {
  id               String     @id @default(cuid())
  /// SHA-256 of the visitor's random cookie token; the raw token is never stored.
  visitorTokenHash String     @unique @map("visitor_token_hash") @db.Char(64)
  status           ChatStatus @default(OPEN)
  lastMessageAt    DateTime   @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  messages ChatMessage[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String     @id @default(cuid())
  conversationId String     @map("conversation_id")
  sender         ChatSender
  body           String     @db.VarChar(2000)
  agentUserId    String?    @map("agent_user_id")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        User?            @relation(fields: [agentUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ─── Administration ─────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.VarChar(40)
  /// Non-sensitive change summary. Never store secrets or full addresses here.
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── Better Auth (admin accounts only; public sign-up is disabled) ─────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          String   @default("staff")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions     Session[]
  accounts     Account[]
  events       TrackingEvent[]
  chatMessages ChatMessage[]
  auditLogs    AuditLog[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// A staff device that receives push notifications (new chats, inquiries, requests). One row per
/// browser/app install; removed when the push service reports it gone.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  endpoint   String   @unique @db.VarChar(1000)
  p256dh     String   @db.VarChar(200)
  auth       String   @db.VarChar(100)
  userAgent  String?  @map("user_agent") @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
