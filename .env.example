# ── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Supabase's direct host (db.<ref>.supabase.co) is IPv6-only. On IPv4 networks use the
# Session Pooler (port 5432) for migrations/dev, or the Transaction Pooler (port 6543,
# add &pgbouncer=true) for serverless deployments. Copy the string from
# Supabase → Project Settings → Database → Connection string.
DB_PASSWORD="<your-database-password>"
DATABASE_URL="postgresql://postgres.<project-ref>:${DB_PASSWORD}@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=20"

# ── Staff authentication (Better Auth) ───────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="<random-32+-character-secret>"
BETTER_AUTH_URL="http://localhost:3000"

# ── Tracking ─────────────────────────────────────────────────────────────────
TRACKING_PROVIDER="database"
# Letters prefixed to generated tracking numbers (max 4).
TRACKING_NUMBER_PREFIX="MP"
# Demo records are visible in development by default and hidden in production unless "true".
# ENABLE_DEMO_DATA="false"

# ── Brand & contact (public; safe to expose) ─────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Meridian Parcel"
NEXT_PUBLIC_BRAND_SHORT_NAME="Meridian"
NEXT_PUBLIC_LEGAL_NAME="Meridian Parcel (placeholder operator)"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="18603983750"
NEXT_PUBLIC_WHATSAPP_DISPLAY="+1 860 398 3750"
NEXT_PUBLIC_CHAT_AGENT_NAME="James"
NEXT_PUBLIC_SUPPORT_TIMEZONE="America/New_York"
NEXT_PUBLIC_SUPPORT_OPEN_HOUR="8"
NEXT_PUBLIC_SUPPORT_CLOSE_HOUR="18"
